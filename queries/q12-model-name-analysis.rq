# Q12 (string functions): Parse model names - extract the model family (text before the first
#      version number) and the version number - and count releases per family.
PREFIX ait:  <https://otavlna.github.io/4iz444-ai-tools-kg/ontology#>
PREFIX aid:  <https://otavlna.github.io/4iz444-ai-tools-kg/data/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT ?family (COUNT(?m) AS ?releases)
       (GROUP_CONCAT(?version; separator=" -> ") AS ?versions)
       (MIN(?released) AS ?firstRelease) (MAX(?released) AS ?lastRelease)
WHERE {
  {
    SELECT ?m ?released ?version ?family
    WHERE {
      ?m a/rdfs:subClassOf* ait:AIModel ;
         rdfs:label ?name ;
         ait:releaseDate ?released .
      FILTER (REGEX(?name, "[0-9]"))
      BIND (REPLACE(?name, "^[^0-9]*?([0-9]+(\\.[0-9]+)?).*$", "$1") AS ?version)
      BIND (UCASE(REPLACE(STRBEFORE(?name, ?version), "[\\s-]*[Vv]?[\\s-]*$", "")) AS ?rawFamily)
      BIND (IF(?rawFamily = "", "O-SERIES", ?rawFamily) AS ?family)
    }
    ORDER BY ?released
  }
}
GROUP BY ?family
HAVING (COUNT(?m) > 1)
ORDER BY DESC(?releases) ?family
