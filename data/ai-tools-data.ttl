@prefix ait:    <https://otavlna.github.io/4iz444-ai-tools-kg/ontology#> .
@prefix aid:    <https://otavlna.github.io/4iz444-ai-tools-kg/data/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .

# Knowledge graph: AI tools catalogue - snapshot of the market as of 30 September 2025
# (see Section 3.2 of the report for the reasons of the cut-off date).
# Prices are list prices per user per month (monthly billing) for individual/team tiers.
# Benchmark scores are compiled from publicly reported (mostly vendor-reported) figures;
# evaluation settings differ between vendors, so the numbers are indicative only.

#################################################################
#    Modalities
#################################################################

aid:Text  a ait:Modality ; rdfs:label "Text" .
aid:Image a ait:Modality ; rdfs:label "Image" .
aid:Audio a ait:Modality ; rdfs:label "Audio" .
aid:Video a ait:Modality ; rdfs:label "Video" .

#################################################################
#    Tasks
#################################################################

aid:Conversation    a ait:Task ; rdfs:label "Conversation" .
aid:TextGeneration  a ait:Task ; rdfs:label "Text generation" .
aid:Summarization   a ait:Task ; rdfs:label "Summarization" .
aid:CodeGeneration  a ait:Task ; rdfs:label "Code generation" .
aid:CodeCompletion  a ait:Task ; rdfs:label "Code completion" .
aid:CodeReview      a ait:Task ; rdfs:label "Code review" .
aid:ImageGeneration a ait:Task ; rdfs:label "Image generation" .
aid:WebSearch       a ait:Task ; rdfs:label "Web search" .
aid:DataAnalysis    a ait:Task ; rdfs:label "Data analysis" .
aid:Reasoning       a ait:Task ; rdfs:label "Knowledge and reasoning" .

#################################################################
#    Integrations
#################################################################

aid:WebApp          a ait:Integration ; rdfs:label "Web application" .
aid:MobileApp       a ait:Integration ; rdfs:label "Mobile app (iOS/Android)" .
aid:DesktopApp      a ait:Integration ; rdfs:label "Desktop application" .
aid:CLI             a ait:Integration ; rdfs:label "Command-line interface" .
aid:VSCode          a ait:Integration ; rdfs:label "Visual Studio Code" .
aid:JetBrains       a ait:Integration ; rdfs:label "JetBrains IDEs" .
aid:Slack           a ait:Integration ; rdfs:label "Slack" .
aid:Discord         a ait:Integration ; rdfs:label "Discord" .
aid:WhatsApp        a ait:Integration ; rdfs:label "WhatsApp" .
aid:ChromeExtension a ait:Integration ; rdfs:label "Chrome extension" .
aid:GoogleWorkspace a ait:Integration ; rdfs:label "Google Workspace" .
aid:GitHubPlatform  a ait:Integration ; rdfs:label "GitHub.com" .
aid:RestAPI         a ait:Integration ; rdfs:label "REST API" .

#################################################################
#    Licences
#################################################################

aid:Proprietary a ait:License ;
    rdfs:label "Proprietary (closed weights)" ;
    ait:spdxId "LicenseRef-Proprietary" .

aid:Apache2 a ait:OpenLicense ;
    rdfs:label "Apache License 2.0" ;
    ait:spdxId "Apache-2.0" .

